#!/bin/sh
# The seam between this project and everything that automates it.
#
# CI, the git hooks and scripts/agent know only the verbs below. Nothing outside
# this file knows harrow is written in Rust, which is what keeps the automation
# from having to be rewritten when any of that changes — and what makes it
# impossible for CI and a local hook to drift apart, since they run the same
# line.
set -eu

cd "$(dirname "$0")/.."

step() {
  printf '\n\033[1;34m▸ %s\033[0m\n' "$1"
}

usage() {
  cat <<'USAGE'
usage: scripts/task <target>

  fmt        format in place
  fmt:check  verify formatting; non-zero on drift
  lint       lint; warnings are errors
  test       the full test suite
  build      compile everything, including the tests
  check      fmt:check, lint, test, build — what CI runs

  conformance:refresh   re-take cairn's item-format corpus
                        (CAIRN_REPO=path, defaults to ../cairn)
USAGE
}

case "${1:-}" in
  fmt)
    cargo fmt --all
    ;;
  fmt:check)
    cargo fmt --all -- --check
    ;;
  lint)
    cargo clippy --all-targets --all-features -- -D warnings
    ;;
  test)
    cargo test --all-targets
    ;;
  build)
    cargo build --all-targets
    ;;
  check)
    step 'format'
    "$0" fmt:check
    step 'lint'
    "$0" lint
    step 'test'
    "$0" test
    step 'build'
    "$0" build
    printf '\n\033[1;32m✓ green\033[0m\n'
    ;;
  conformance:refresh)
    # The corpus is vendored rather than read from a sibling checkout, because
    # the suite has to pass on a machine that has never heard of cairn — the
    # same reason harrow reads the files rather than shelling out. Vendored
    # means it can go stale, so refreshing it is one command and its diff is
    # the review.
    src=${CAIRN_REPO:-../cairn}/tests/golden
    dst=tests/fixtures/conformance
    [ -d "$src" ] || {
      printf 'scripts/task: no corpus at %s; set CAIRN_REPO\n' "$src" >&2
      exit 1
    }
    version=$(git -C "${CAIRN_REPO:-../cairn}" describe --tags --abbrev=0 2>/dev/null || echo unknown)
    sha=$(git -C "${CAIRN_REPO:-../cairn}" rev-parse --short HEAD 2>/dev/null || echo unknown)
    # The note says where the corpus came from and why it is here. The first
    # two lines are the part that goes stale, so they are rewritten and the
    # rest is kept — otherwise refreshing would silently drop the reason.
    why=$(tail -n +3 "$dst/PROVENANCE")
    rm -rf "$dst"
    mkdir -p "$dst"
    cp -R "$src"/. "$dst"/
    rm -f "$dst/README.md"
    {
      printf 'cairn %s (%s)\n' "$version" "$sha"
      printf 'taken %s\n' "$(date +%Y-%m-%d)"
      printf '%s\n' "$why"
    } >"$dst/PROVENANCE"
    printf 'corpus refreshed from cairn %s (%s); read the diff\n' "$version" "$sha"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    printf 'scripts/task: unknown target %s\n\n' "${1:-<none>}" >&2
    usage >&2
    exit 2
    ;;
esac
