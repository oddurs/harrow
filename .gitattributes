# One line ending everywhere, so a checkout on another platform does not churn.
* text=auto eol=lf

# Recorded screens. Byte-exact by definition — never touched by a filter.
tests/snapshots/*.txt text eol=lf
tests/fixtures/* text eol=lf

# cairn item files, which are also the project's roadmap.
cairn/items/*.md text eol=lf

# Not written by hand, and not worth reviewing line by line.
Cargo.lock linguist-generated=true
ROADMAP.md linguist-generated=true
