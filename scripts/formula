#!/bin/sh
# Print the Homebrew formula for a release.
#
#   scripts/formula 0.1.0 SHA256SUMS
#
# The release workflow runs this and attaches the result, so updating the tap is
# a copy rather than four checksums transcribed by hand. Run it yourself against
# a downloaded SHA256SUMS to check what CI produced.
set -eu

version=${1:-}
sums=${2:-}
if [ -z "$version" ] || [ -z "$sums" ]; then
  echo "usage: scripts/formula <version> <SHA256SUMS>" >&2
  exit 2
fi

# The checksum for one target, from a `<sha>  <file>` listing.
#
# Read into variables before the formula is written rather than substituted
# into it: `exit 1` inside `$(...)` leaves the subshell, not the script, so a
# missing checksum would otherwise produce a formula with a blank one and a
# successful exit.
sha() {
  line=$(grep "harrow-${version}-$1.tar.gz\$" "$sums" || true)
  if [ -z "$line" ]; then
    echo "formula: no checksum for $1 in $sums" >&2
    return 1
  fi
  printf '%s' "${line%% *}"
}

macos_arm=$(sha aarch64-apple-darwin)
macos_intel=$(sha x86_64-apple-darwin)
linux_arm=$(sha aarch64-unknown-linux-musl)
linux_intel=$(sha x86_64-unknown-linux-musl)

cat <<FORMULA
# Generated by scripts/formula from the release's SHA256SUMS. Do not edit by
# hand: the next release overwrites it.
class Harrow < Formula
  desc "Work a cairn backlog from the terminal"
  homepage "https://github.com/oddurs/harrow"
  version "${version}"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/oddurs/harrow/releases/download/v#{version}/harrow-#{version}-aarch64-apple-darwin.tar.gz"
      sha256 "${macos_arm}"
    end
    on_intel do
      url "https://github.com/oddurs/harrow/releases/download/v#{version}/harrow-#{version}-x86_64-apple-darwin.tar.gz"
      sha256 "${macos_intel}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/oddurs/harrow/releases/download/v#{version}/harrow-#{version}-aarch64-unknown-linux-musl.tar.gz"
      sha256 "${linux_arm}"
    end
    on_intel do
      url "https://github.com/oddurs/harrow/releases/download/v#{version}/harrow-#{version}-x86_64-unknown-linux-musl.tar.gz"
      sha256 "${linux_intel}"
    end
  end

  # harrow reads a cairn backlog without it and changes one with it.
  depends_on "oddurs/cairn/cairn" => :optional

  def install
    bin.install "harrow"
    doc.install "README.md", "THEMES.md"
  end

  test do
    assert_match "harrow #{version}", shell_output("#{bin}/harrow --version")
  end
end
FORMULA
